{
  "name": "form-lembur",
  "version": "1.0.0",
  "description": "Pembuat Form Lembur (Activity Report Lemburan)",
  "main": "main.js",
  "author": "Form Lembur",
  "scripts": {
    "start": "electron ."
  },
  "dependencies": {
    "@capacitor/android": "^6.2.0",
    "@capacitor/cli": "^6.2.0",
    "@capacitor/core": "^6.2.0",
    "@capacitor/filesystem": "^6.0.2",
    "@capacitor/share": "^6.0.3"
  },
  "devDependencies": {
    "electron": "^33.2.0",
    "electron-builder": "^25.1.8"
  },
  "build": {
    "appId": "com.formlembur.app",
    "productName": "Form Lembur",
    "files": [
      "main.js",
      "www/**/*"
    ],
    "win": {
      "target": "portable",
      "artifactName": "Form-Lembur.exe",
      "signAndEditExecutable": false
    }
  }
}